# ==============================================================================
# IP-SAKTI Sahayak - Backend FastAPI Environment Configuration
# Copy this file to backend/.env
# ==============================================================================

# Application Execution Mode
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# PostgreSQL + pgvector Connection String
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ipsakti_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# Google Gemini API Configuration
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere123456789
GEMINI_MODEL_PRIMARY=gemini-2.0-flash
GEMINI_MODEL_REASONING=gemini-2.0-pro-exp-02-05
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Security and Authentication
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (JSON Array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Storage and Directories
STATUTES_DIR=../data/statutes
PHARMACOPOEIA_DIR=../data/pharmacopoeia
STORAGE_EXPORTS_DIR=./storage/exports
STORAGE_DOSSIERS_DIR=./storage/generated_dossiers

# Ayush Domain Feature Flags
ENABLE_TKDL_HEATMAP_SIMULATION=true
ENABLE_CHOU_TALALAY_SYNERGISM=true
ENABLE_BDA_2024_ABS_CALCULATOR=true
ENABLE_DUAL_JURISDICTION_ANALYSIS=true
