# ==============================================================================
# IP-SAKTI Sahayak - Frontend Next.js Environment Configuration
# Copy this file to frontend/.env.local or frontend/.env
# ==============================================================================

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Frontend Public Metadata
NEXT_PUBLIC_APP_NAME="IP-SAKTI Sahayak"
NEXT_PUBLIC_APP_DESCRIPTION="AI-Powered Ayush Patent, Legal & Regulatory Compliance Portal"

# Speech-to-Text & Translation (Optional Client Fallback)
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,hi,ta,te,kn,ml,mr,bn,gu

# PDF Viewer Worker & Rendering Engine
NEXT_PUBLIC_ENABLE_PDF_INSPECTOR=true

# Analytics / Telemetry Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
